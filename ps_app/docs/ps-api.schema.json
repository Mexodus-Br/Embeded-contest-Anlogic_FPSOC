        },
        "fixture_id": {
          "$ref": "#/$defs/id"
        },
        "scope": {
          "const": "host_fixture_only"
        },
        "start_position_id": {
          "$ref": "#/$defs/id"
        },
        "duration_us": {
          "$ref": "#/$defs/u64"
        },
        "legs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/leg"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        },
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "preview_id": {
          "$ref": "#/$defs/id"
        },
        "parameter_version": {
          "$ref": "#/$defs/id"
        },
        "state_version": {
          "$ref": "#/$defs/u64"
        },
        "expires_monotonic_us": {
          "$ref": "#/$defs/u64"
        },
        "repeat": {
          "$ref": "#/$defs/repeat"
        },
        "cycle_duration_us": {
          "anyOf": [
            {
              "$ref": "#/$defs/u64"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "executable",
        "target",
        "errors",
        "sample_count",
        "preview_id",
        "parameter_version",
        "state_version",
        "expires_monotonic_us",
        "repeat",
        "cycle_duration_us"
      ],
      "additionalProperties": false
    },
    "run_request": {
      "type": "object",
      "properties": {
        "boot_id": {
          "$ref": "#/$defs/id"
        },
