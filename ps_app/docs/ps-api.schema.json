{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:delta:ps:api:1",
  "title": "D1 host simulation API v1",
  "$comment": "Select a $defs entry using the endpoint mapping in ps-api.md. Numeric/geometry cross-field constraints remain authoritative in the C++ validator.",
  "$defs": {
    "u64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Canonical decimal uint64; service additionally checks <=18446744073709551615."
    },
    "i64": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]{0,18})$",
      "description": "Canonical decimal int64; service additionally checks signed bounds."
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "xyz": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "steps": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/i64"
        },
        {
          "$ref": "#/$defs/i64"
        },
        {
          "$ref": "#/$defs/i64"
        },
        {
          "const": "0"
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "empty": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "leg": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "sample": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "details": {
          "type": "object"
        }
      },
      "required": [
        "code",
        "message",
        "field",
        "leg",
        "sample",
        "details"
      ],
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "properties": {
        "ok": {
          "const": false
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "required": [
        "ok",
        "error"
      ],
      "additionalProperties": false
    },
    "point": {
      "type": "object",
      "properties": {
        "xyz_mm": {
          "$ref": "#/$defs/xyz"
        },
        "duration_us": {
          "anyOf": [
            {
              "$ref": "#/$defs/u64"
            },
            {
              "type": "null"
            }
          ]
        },
        "dwell_us": {
          "$ref": "#/$defs/u64"
        }
      },
      "required": [
        "xyz_mm"
      ],
      "additionalProperties": false
    },
    "repeat": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "finite"
            },
            "count": {
              "$ref": "#/$defs/u64"
            }
          },
          "required": [
            "mode",
            "count"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "until_stopped"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        }
      ]
    },
    "task": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "parameter_version": {
          "$ref": "#/$defs/id"
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "repeat": {
          "$ref": "#/$defs/repeat"
        }
      },
      "required": [
        "points"
      ],
      "additionalProperties": false
    },
    "box": {
      "type": "object",
      "properties": {
        "min": {
          "$ref": "#/$defs/xyz"
        },
        "max": {
          "$ref": "#/$defs/xyz"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false
    },
    "fixture": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "speed_mm_s": {
          "type": "number"
        },
        "acceleration_mm_s2": {
          "type": "number"
        },
        "sample_us": {
          "$ref": "#/$defs/u64"
        },
        "max_sample_distance_mm": {
          "type": "number"
        },
        "max_samples": {
          "$ref": "#/$defs/u64"
        },
        "workspace": {
          "$ref": "#/$defs/box"
        },
        "forbidden_boxes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/box"
          },
          "maxItems": 128
        },
        "joint_min_deg": {
          "$ref": "#/$defs/xyz"
        },
        "joint_max_deg": {
          "$ref": "#/$defs/xyz"
        },
        "max_joint_step_deg": {
          "type": "number"
        },
        "pulse_interval_us": {
          "$ref": "#/$defs/u64"
        },
        "segment_guard_us": {
          "$ref": "#/$defs/u64"
        },
        "max_duration_us": {
          "$ref": "#/$defs/u64"
        }
      },
      "required": [
        "id",
        "speed_mm_s",
        "acceleration_mm_s2",
        "sample_us",
        "max_sample_distance_mm",
        "max_samples",
        "workspace",
        "forbidden_boxes",
        "joint_min_deg",
        "joint_max_deg",
        "max_joint_step_deg",
        "pulse_interval_us",
        "segment_guard_us",
        "max_duration_us"
      ],
      "additionalProperties": false
    },
    "golden": {
      "type": "object",
      "properties": {
        "base_radius_mm": {
          "type": "number"
        },
        "effector_radius_mm": {
          "type": "number"
        },
        "upper_length_mm": {
          "type": "number"
        },
        "lower_length_mm": {
          "type": "number"
        },
        "main_gear_teeth": {
          "type": "number"
        },
        "motor_gear_teeth": {
          "type": "number"
        },
        "microsteps": {
          "type": "number"
        },
        "steps_per_rev": {
          "type": "number"
        },
        "angle_offset_deg": {
          "$ref": "#/$defs/xyz"
        },
        "step_offset": {
          "$ref": "#/$defs/xyz"
        },
        "inverse": {
          "type": "array",
          "items": {
            "type": "boolean"
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "parameters": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "fixture": {
          "$ref": "#/$defs/fixture"
        },
        "golden": {
          "$ref": "#/$defs/golden"
        }
      },
      "required": [
        "schema_version",
        "id",
        "fixture",
        "golden"
      ],
      "additionalProperties": false
    },
    "pose": {
      "type": "object",
      "properties": {
        "xyz_mm": {
          "$ref": "#/$defs/xyz"
        },
        "joint_deg": {
          "$ref": "#/$defs/xyz"
        },
        "steps": {
          "$ref": "#/$defs/steps"
        },
        "angles_rad": {
          "$ref": "#/$defs/xyz"
        },
        "raw_steps": {
          "$ref": "#/$defs/xyz"
        },
        "rad_to_step_factor": {
          "type": "number"
        },
        "axis_order": {
          "const": [
            "high",
            "low",
            "rot",
            "M4_disabled"
          ]
        }
      },
      "required": [
        "xyz_mm",
        "joint_deg",
        "steps"
      ],
      "additionalProperties": false
    },
    "position": {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "simulation",
            "unknown"
          ]
        },
        "model": {
          "const": "sample_endpoint_simulation"
        },
        "valid": {
          "type": "boolean"
        },
        "stale": {
          "type": "boolean"
        },
        "position_id": {
          "$ref": "#/$defs/id"
        },
        "parameter_version": {
          "type": "string"
        },
        "xyz_mm": {
          "anyOf": [
            {
              "$ref": "#/$defs/xyz"
            },
            {
              "type": "null"
            }
          ]
        },
        "joint_deg": {
          "anyOf": [
            {
              "$ref": "#/$defs/xyz"
            },
            {
              "type": "null"
            }
          ]
        },
        "steps": {
          "anyOf": [
            {
              "$ref": "#/$defs/steps"
            },
            {
              "type": "null"
            }
          ]
        },
        "updated_monotonic_us": {
          "$ref": "#/$defs/u64"
        }
      },
      "required": [
        "source",
        "model",
        "valid",
        "stale",
        "position_id",
        "parameter_version",
        "xyz_mm",
        "joint_deg",
        "steps",
        "updated_monotonic_us"
      ],
      "additionalProperties": false
    },
    "leg": {
      "type": "object",
      "properties": {
        "from_mm": {
          "$ref": "#/$defs/xyz"
        },
        "to_mm": {
          "$ref": "#/$defs/xyz"
