        "acceleration_time_s": {
          "type": "number"
        },
        "peak_speed_mm_s": {
          "type": "number"
        },
        "profile": {
          "enum": [
            "trapezoid",
            "triangle"
          ]
        },
        "specified_duration": {
          "type": "boolean"
        }
      },
      "required": [
        "from_mm",
        "to_mm",
        "start_us",
        "duration_us",
        "acceleration_time_s",
        "peak_speed_mm_s",
        "profile",
        "specified_duration"
      ],
      "additionalProperties": false
    },
    "preview_request": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "parameter_version": {
          "$ref": "#/$defs/id"
        },
        "start_position_id": {
          "$ref": "#/$defs/id"
        },
        "task": {
