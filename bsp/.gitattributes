*.sh text eol=lf
*.tcl text eol=lf
*.py text eol=lf
*.patch text eol=lf
*.dts text eol=lf
*.fragment text eol=lf
*defconfig text eol=lf
evidence/** -whitespace
# Preserve raw GP build/serial/transport evidence and its recorded byte hashes.
evidence/gp-* -text
evidence/dma-* -text
*.patch -whitespace

# Motion evidence is raw; preserve SHA256 across checkouts.
evidence/motion-* -text
evidence/motion-*/** -text
motion/** text eol=lf
# Coordinate scope delivery records raw source/evidence byte identities.
scope/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
scripts/board_scope_*.sh -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
evidence/scope-* -text
evidence/scope-*/** -text
